# Everything below is GENERATED by running this project, or is a credential.
# None of it belongs in git.

# --- scrape output ---------------------------------------------------------
*.json
*.csv
# Committed on purpose: a real, scrubbed excerpt of a real listing run, so a
# reader can see the output shape without installing anything. Its metadata
# sidecar travels with it.
!sample_output.json
!sample_output.csv
!sample_output.meta.json
*.latest_attempt.meta.json
avito.*
avito_listings.*
# This repo's own working output, and the canary's.
live/
canary.json
canary.csv
canary*.meta.json

# --- debug artifacts ---------------------------------------------------------
# --dump-html writes the page on success too. A dump carries the session that
# fetched it and sellers' personal details.
*_debug.html
*_debug.png
*.html.page*
*_p[0-9]*.html

# --- raw research captures ---------------------------------------------------
recon/
captures/
artifacts/

# --- a downloaded 2captcha proxy list is a credential file -------------------
# Every line carries a login and a password. The glob covers the variants
# people make (proxylist-ru.txt, proxylist.2.txt) and stops there.
proxylist*.txt

# --- caches ------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.fingerprint_cache/

# --- packaging build artifacts -----------------------------------------------
*.egg-info/
dist/
build/

# --- environments ------------------------------------------------------------
.venv/
venv/
env/

# --- editors / OS ------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
.claude/

# --- never, under any circumstances --------------------------------------------
# EVERY .env variant, not just `.env`: a `.env.user-endpoint.bak` was committed
# in a sibling repo because `.gitignore` listed the exact name and the backup
# had a suffix. Only the documented example is exempt.
*.log
*.key
secrets*
.env
.env.*
!.env.example
*.bak
